{
    "name": "jackal-js",
    "version": "1.0.0",
    "private": true,
    "license": "GPL-3.0-or-later",
    "type": "module",
    "scripts": {
        "stamp": "node scripts/stamp-build.mjs",
        "clean": "node scripts/clean-dist.mjs",
        "dev": "npm run dev:pwa",
        "dev:pwa": "vite --config pwa/vite.config.ts --host 127.0.0.1",
        "build:pwa": "npm run build:pwa:release",
        "build:pwa:release": "node scripts/build-pwa-release.mjs",
        "_build:pwa:release": "tsc --project pwa/tsconfig.json && vite build --config pwa/vite.config.ts",
        "build:about": "node scripts/build-about.mjs .release-components/web",
        "build:desktop": "node scripts/build-desktop.mjs",
        "_assemble": "node scripts/assemble.mjs .release-components/web",
        "verify": "npm test && npm run lint && npm run typecheck",
        "build:web": "npm run verify && node scripts/build-web-release.mjs",
        "build": "npm run verify && node scripts/build-release.mjs",
        "release:web": "npm run build:web",
        "release:desktop": "npm run verify && npm run build:desktop && node scripts/copy-desktop-release.mjs",
        "run:desktop": "node scripts/run-desktop.mjs",
        "preview": "npm run preview:pwa",
        "preview:pwa": "vite preview --config pwa/vite.config.ts --host 127.0.0.1",
        "preview:dist": "vite preview --host 127.0.0.1 --outDir dist",
        "test": "node --test scripts/test-*.mjs",
        "verify:pwa-precache": "node scripts/verify-pwa-precache.mjs",
        "verify:release": "node scripts/verify-release-candidate.mjs",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint .",
        "typecheck": "tsc --project pwa/tsconfig.json --noEmit"
    },
    "dependencies": {
        "slick2d-ts": "git+https://github.com/meatfighter/slick2d-ts.git#semver:^1.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.2.0",
        "eslint": "^10.8.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.65.0",
        "vite": "^7.0.0"
    }
}
