{
    "name": "jackal-js",
    "version": "1.0.5",
    "private": true,
    "description": "A TypeScript/WebGL browser port of Jackal with a maintained Java/Slick2D reference implementation.",
    "homepage": "https://meatfighter.com/jackal/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/meatfighter/jackal-js.git"
    },
    "bugs": {
        "url": "https://github.com/meatfighter/jackal-js/issues"
    },
    "license": "SEE LICENSE IN COPYRIGHT.md",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "stamp": "node scripts/stamp-build.mjs",
        "clean": "node scripts/clean-dist.mjs",
        "dev": "npm run dev:pwa",
        "dev:pwa": "vite --config pwa/vite.config.ts --host 127.0.0.1",
        "build:pwa": "npm run build:pwa:release",
        "build:pwa:release": "node scripts/build-pwa-release.mjs",
        "_build:pwa:release": "tsc --project pwa/tsconfig.json && vite build --config pwa/vite.config.ts",
        "build:about": "node scripts/build-about.mjs .release-components/web",
        "build:desktop": "node scripts/build-desktop.mjs",
        "_assemble": "node scripts/assemble.mjs .release-components/web",
        "verify": "npm run test:session-ownership && npm test && npm run format:check && npm run lint && npm run typecheck && npm run check:ts-nocheck && npm run check:explicit-any && npm run check:java-float-parity",
        "verify:dependencies": "npm audit --audit-level=high",
        "build:web": "npm run verify && node scripts/build-web-release.mjs",
        "build": "npm run verify && node scripts/build-release.mjs",
        "release": "npm run verify:dependencies && npm run build",
        "qualify": "node scripts/assert-clean-git.mjs && npm run release && npm run verify:browser && npm run verify:game-mode-persistence && npm run verify:departure-save && node scripts/assert-clean-git.mjs",
        "qualify:browsers": "node scripts/run-browser-qualification-suite.mjs",
        "release:web": "npm run verify:dependencies && npm run build:web",
        "release:desktop": "node scripts/release-desktop.mjs",
        "run:desktop": "node scripts/run-desktop.mjs",
        "preview": "npm run preview:pwa",
        "preview:pwa": "vite preview --config pwa/vite.config.ts --host 127.0.0.1",
        "preview:about": "vite preview --host 127.0.0.1 --outDir .release-components/web",
        "preview:dist": "vite preview --host 127.0.0.1 --outDir dist",
        "test": "node --test scripts/test-*.mjs",
        "test:parity": "node --test scripts/test-java-*.mjs scripts/test-direction-cache-parity.mjs scripts/test-persistence-parity-coverage.mjs scripts/test-fixed-update-fade-timing.mjs",
        "benchmark:directions": "node scripts/benchmark-direction-cache.mjs",
        "verify:desktop": "node scripts/verify-desktop-zip.mjs",
        "verify:pwa-precache": "node scripts/verify-pwa-precache.mjs",
        "verify:release": "node scripts/verify-release-candidate.mjs",
        "check:ts-nocheck": "node scripts/check-ts-nocheck-budget.mjs",
        "check:explicit-any": "node scripts/check-explicit-any.mjs",
        "check:java-float-parity": "node scripts/check-java-float-parity.mjs",
        "benchmark:float-parity": "node scripts/benchmark-java-float-parity.mjs",
        "generate:java-float-metadata": "node scripts/java-float-parity/generate-java-float-metadata.mjs",
        "generate:java-float-state": "node scripts/java-float-parity/generate-java-float-state.mjs",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint .",
        "typecheck": "tsc --project pwa/tsconfig.json --noEmit",
        "verify:browser": "node scripts/run-browser-verification.mjs && node scripts/run-offline-verification.mjs",
        "memory:smoke": "node scripts/run-memory-smoke.mjs",
        "test:session-ownership": "node --test scripts/test-session-ownership.mjs",
        "verify:fullscreen": "node scripts/run-fullscreen-qualification.mjs",
        "verify:fullscreen-timeout": "node scripts/run-fullscreen-timeout-qualification.mjs",
        "verify:fullscreen-reentry": "node scripts/run-fullscreen-reentry-qualification.mjs",
        "verify:fullscreen-settings": "node scripts/run-fullscreen-settings-qualification.mjs",
        "verify:production-browser": "node scripts/run-production-browser-qualification.mjs",
        "verify:activation-races": "node scripts/run-activation-race-qualification.mjs",
        "verify:audio-interruption": "node scripts/run-audio-interruption-qualification.mjs",
        "verify:lifecycle-events": "node scripts/run-lifecycle-event-qualification.mjs",
        "verify:ownership-transfer": "node scripts/run-ownership-transfer-qualification.mjs",
        "verify:persistence-failure": "node scripts/run-persistence-failure-qualification.mjs",
        "verify:lifecycle-stress": "node scripts/run-lifecycle-stress-qualification.mjs",
        "release:archive": "node scripts/archive-release.mjs",
        "test:persistence-contract": "node --test scripts/test-persistence-contract.mjs scripts/test-persistence-shell-contract.mjs scripts/test-persistence-settings-contract.mjs scripts/test-game-state-save-preservation.mjs scripts/test-mapping-persistence-contract.mjs && npm run test:durable-suspension",
        "verify:game-mode-persistence": "node scripts/run-game-mode-persistence-qualification.mjs",
        "test:durable-suspension": "node --test scripts/test-durable-suspension.mjs",
        "verify:departure-save": "node scripts/run-departure-save-qualification.mjs"
    },
    "dependencies": {
        "slick2d-ts": "https://codeload.github.com/meatfighter/slick2d-ts/tar.gz/03b6878aab0106702651f41259c250288c3eb345"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.0",
        "eslint": "^10.11.0",
        "playwright": "1.63.0",
        "prettier": "^3.9.9",
        "sharp": "^0.35.5",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2"
    }
}
