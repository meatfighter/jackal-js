{
    "name": "Jackal",
    "short_name": "Jackal",
    "description": "A browser PWA port of Jackal.",
    "id": "/jackal",
    "start_url": "./",
    "scope": "__BASE_URL__",
    "display": "standalone",
    "background_color": "#000000",
    "theme_color": "#000000",
    "icons": [
        {
            "src": "__BASE_URL__resources/icons/32x32.png?v=__RESOURCE_VERSION__(icons/32x32.png)",
            "sizes": "32x32",
            "type": "image/png"
        },
        {
            "src": "__BASE_URL__resources/icons/192x192.png?v=__RESOURCE_VERSION__(icons/192x192.png)",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "__BASE_URL__resources/icons/512x512.png?v=__RESOURCE_VERSION__(icons/512x512.png)",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "__BASE_URL__resources/icons/512x512-maskable.png?v=__RESOURCE_VERSION__(icons/512x512-maskable.png)",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
