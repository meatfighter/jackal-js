{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": false,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "types": ["vite/client"]
    },
    "include": ["src", "tools", "vite.config.ts"]
}
